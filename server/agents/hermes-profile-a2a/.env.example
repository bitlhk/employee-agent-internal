A2A_HOST=127.0.0.1
A2A_PORT=8898
HERMES_PROFILE=ppt-expert
HERMES_TOOLSETS=terminal,file,vision
HERMES_PROFILE_WORKSPACE=/home/ubuntu/.hermes/profiles/ppt-expert/workspace
A2A_WORKSPACES_ROOT=/home/ubuntu/.hermes/profiles/ppt-expert/a2a-workspaces
A2A_PUBLIC_BASE_URL=https://work.example.com/a2a/ppt-expert
A2A_TASK_TIMEOUT_SECONDS=1350
HERMES_MAX_TURNS=100
A2A_MAX_CONCURRENT_TASKS=2
A2A_MAX_CONTEXTS=256
A2A_CONTEXT_TTL_SECONDS=2592000
A2A_CLEANUP_INTERVAL_SECONDS=3600
A2A_WORKSPACE_KIND=ppt
A2A_REQUIRE_PPT_TOOLS=1
A2A_REQUIRE_ARTIFACTS=0
A2A_AGENT_NAME=PPT 设计师
A2A_HERMES_SKILLS=cyber-ppt
A2A_BEARER_TOKEN=replace-with-at-least-32-random-characters
A2A_DOWNLOAD_SECRET=replace-with-at-least-32-random-characters
