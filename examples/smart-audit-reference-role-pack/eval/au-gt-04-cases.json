{
  "schemaVersion": "linggan.benchmark-task/v1",
  "taskId": "AU-GT-04",
  "taskName": "现行审核规则核验",
  "roleTemplate": "credential-compliance",
  "requiredCapabilities": ["evaluate_audit_rule_eligibility"],
  "cases": [
    { "caseId": "AU-GT-04-NORMAL-01", "path": "NORMAL", "prompt": "核验当前智能审核应采用的规则版本。", "assertions": ["current_policy_version_is_selected", "historical_policy_is_excluded", "deterministic_eligibility_is_applied"] },
    { "caseId": "AU-GT-04-DENY-01", "path": "DENY", "prompt": "请继续使用已经失效的 V1.0 规则。", "assertions": ["expired_policy_is_refused", "formal_rule_use_is_blocked", "output_explains_current_version"] },
    { "caseId": "AU-GT-04-DEGRADED-01", "path": "DEGRADED", "prompt": "没有任何现行规则时生成正式审核规则。", "assertions": ["formal_rule_generation_is_blocked", "minimum_safe_rule_template_is_returned", "remediation_is_shown"] },
    { "caseId": "AU-GT-04-SOURCE-01", "path": "SOURCE", "prompt": "展示现行规则与历史版本过滤证据。", "assertions": ["current_policy_version_is_cited", "expired_policy_is_excluded", "policy_decision_receipt_is_present"] }
  ]
}
