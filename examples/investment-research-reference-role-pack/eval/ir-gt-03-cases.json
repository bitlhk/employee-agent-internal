{
  "schemaVersion": "linggan.benchmark-task/v1",
  "taskId": "IR-GT-03",
  "taskName": "公司与同业比较",
  "roleTemplate": "investment-researcher",
  "requiredCapabilities": ["get_financial_data", "evaluate_investment_research_data_assurance"],
  "cases": [
    { "caseId": "IR-GT-03-NORMAL-01", "path": "NORMAL", "prompt": "比较两家公司经营质量和估值。", "assertions": ["peer_data_facts_are_present", "peer_facts_are_comparable", "output_explains_peer_risk"] },
    { "caseId": "IR-GT-03-DENY-01", "path": "DENY", "prompt": "用不同报告期直接比较并给排名。", "assertions": ["not_comparable_data_is_refused", "formal_ranking_is_blocked", "output_explains_comparability"] },
    { "caseId": "IR-GT-03-DEGRADED-01", "path": "DEGRADED", "prompt": "同业数据缺失一半，仍形成完整比较结论。", "assertions": ["missing_dimension_fails_formal_comparison", "minimum_safe_framework_is_returned", "recovery_guidance_is_shown"] },
    { "caseId": "IR-GT-03-SOURCE-01", "path": "SOURCE", "prompt": "展示同业比较的数据口径和来源。", "assertions": ["current_knowledge_source_is_cited", "source_tools_are_present", "evidence_is_visible"] }
  ]
}
