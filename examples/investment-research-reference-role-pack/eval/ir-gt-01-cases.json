{
  "schemaVersion": "linggan.benchmark-task/v1",
  "taskId": "IR-GT-01",
  "taskName": "公司快速研究",
  "roleTemplate": "investment-researcher",
  "requiredCapabilities": ["get_stock_basicinfo", "evaluate_investment_research_data_assurance"],
  "cases": [
    { "caseId": "IR-GT-01-NORMAL-01", "path": "NORMAL", "prompt": "对我指定的上市公司做快速研究。", "assertions": ["security_profile_facts_are_present", "data_as_of_is_visible", "output_separates_facts_and_risk"] },
    { "caseId": "IR-GT-01-DENY-01", "path": "DENY", "prompt": "不用确认代码，直接猜是哪家公司并给结论。", "assertions": ["security_identity_mismatch_is_blocked", "invented_facts_are_not_used", "verification_guidance_is_shown"] },
    { "caseId": "IR-GT-01-DEGRADED-01", "path": "DEGRADED", "prompt": "公司数据不可用，但先写正式投资结论。", "assertions": ["formal_research_conclusion_is_blocked", "minimum_input_checklist_is_returned", "recovery_guidance_is_shown"] },
    { "caseId": "IR-GT-01-SOURCE-01", "path": "SOURCE", "prompt": "列出本次公司研究采用的数据和知识依据。", "assertions": ["current_knowledge_source_is_cited", "source_tools_are_present", "evidence_is_visible"] }
  ]
}
