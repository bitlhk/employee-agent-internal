{
  "name": "employee-agent",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm run dev:client & pnpm run dev:server",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "pnpm run build:client",
    "build:client": "vite build --config client/vite.config.ts --mode production --logLevel warn",
    "start": "NODE_ENV=production tsx server/_core/index.ts",
    "start:client": "vite preview --config client/vite.config.ts",
    "start:server": "NODE_ENV=production tsx server/_core/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "lint:report": "eslint .",
    "lint:type-debt": "node scripts/check-type-debt.mjs",
    "lint:module-size": "node scripts/check-module-size.mjs",
    "lint:dependencies": "node scripts/check-dependency-policy.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration:db": "RUN_DB_INTEGRATION_TESTS=1 vitest run server/db/governance-runtime.integration.test.ts server/db/role-pack-releases.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:critical": "node scripts/check-critical-coverage.mjs",
    "test:e2e:scroll": "playwright test --config playwright.scroll.config.ts",
    "knowledge:test": "bash -lc '\"${KNOWLEDGE_PYTHON:-$HOME/.venvs/employee-agent-knowledge/bin/python}\" -m unittest discover -s server/knowledge -p \"test_*.py\" -v'",
    "knowledge:demo:validate": "tsx scripts/import-demo-knowledge.ts --validate",
    "knowledge:rolepack": "tsx scripts/import-demo-knowledge.ts",
    "knowledge:evaluate": "bash -lc '[[ \"$1\" == \"--\" ]] && shift; \"${KNOWLEDGE_PYTHON:-$HOME/.venvs/employee-agent-knowledge/bin/python}\" server/knowledge/evaluate.py \"$@\"' knowledge-evaluate",
    "load:capacity": "node scripts/load-test-capacity.mjs",
    "load:business": "node scripts/load-test-business.mjs",
    "load:training": "node scripts/load-test-business.mjs",
    "test:load-config": "node --test scripts/lib/load-test-profiles.test.mjs",
    "db:push": "drizzle-kit push",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:baseline:repair": "tsx scripts/db-baseline-repair.ts",
    "db:migrate": "tsx scripts/db-migrate.ts apply",
    "db:migrate:adopt": "tsx scripts/db-migrate.ts adopt-current",
    "db:migrate:check": "tsx scripts/db-migrate.ts check",
    "db:migrate:status": "tsx scripts/db-migrate.ts status",
    "release:build": "bash scripts/build-release.sh",
    "release:status": "bash scripts/release-status.sh",
    "release:test": "bash scripts/test-release-manifest.sh && node --test scripts/verify-github-release-checks.test.mjs && bash scripts/test-release-flow.sh && bash scripts/test-production-verifier.sh && bash scripts/test-backup-sync.sh && bash -n scripts/sync-latest-backup.sh scripts/install-backup-sync-timer.sh scripts/backup-production.sh scripts/install-restore-drill-timer.sh scripts/run-restore-drill.sh",
    "restore:drill": "bash scripts/run-restore-drill.sh",
    "restore:reconcile": "tsx scripts/migrate-skill-store.ts --apply --reconcile --reset-runtime-paths",
    "db:reset": "tsx scripts/reset-db.ts && pnpm exec drizzle-kit push",
    "db:add-blocked-enum": "tsx scripts/add-blocked-to-ip-management-enum.ts",
    "db:backup-users": "tsx scripts/backup-user-data.ts",
    "mcp:identity:init": "node scripts/generate-enterprise-mcp-keypair.mjs",
    "mcp:markers:configure": "tsx scripts/configure-insurance-marker-mcps.ts",
    "mcp:demo:configure": "tsx scripts/configure-governance-demo-mcp.ts",
    "models:catalog:volc": "tsx scripts/configure-volc-model-catalog.ts",
    "rolepack:wealth:install": "tsx scripts/install-wealth-manager-reference-pack.ts",
    "rolepack:wealth:contracts": "tsx scripts/run-wealth-role-pack-contracts.ts",
    "rolepack:wealth:scenarios": "tsx scripts/run-wealth-role-pack-scenarios.ts",
    "rolepack:wealth:model-scenarios": "tsx scripts/run-wealth-role-pack-model-scenarios.ts",
    "rolepack:insurance:install": "tsx scripts/install-insurance-advisor-reference-pack.ts",
    "rolepack:insurance:contracts": "tsx scripts/run-insurance-role-pack-contracts.ts",
    "rolepack:insurance:scenarios": "tsx scripts/run-insurance-role-pack-scenarios.ts",
    "rolepack:replication:validate": "tsx scripts/run-role-replication-validation.ts",
    "audit:drain-dlq": "tsx scripts/drain-audit-dlq.ts",
    "audit:dependencies": "pnpm audit --prod --audit-level moderate",
    "stats:backfill": "tsx scripts/visit-stats-backfill.ts",
    "stats:reconcile": "tsx scripts/visit-stats-reconcile.ts",
    "compress:images": "tsx scripts/compress-images.ts",
    "convert:webp": "tsx scripts/convert-to-webp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@trpc/server": "^11.6.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie": "^1.0.2",
    "croner": "^10.0.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "form-data": "^4.0.6",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^4.2.0",
    "jose": "6.1.0",
    "mysql2": "^3.15.0",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "6.2.108",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remend": "1.3.0",
    "superjson": "^1.13.3",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "ws": "^8.21.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
